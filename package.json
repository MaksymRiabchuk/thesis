{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vue-tsc --noEmit && vite build",
        "type-check": "vue-tsc --noEmit",
        "ziggy": "php artisan ziggy:generate resources/js/ziggy.js && php artisan ziggy:generate --types",
        "lint": "eslint \"resources/js/**/*.{js,ts,vue}\"",
        "lint:fix": "eslint \"resources/js/**/*.{js,ts,vue}\" --fix",
        "format": "prettier --write \"resources/js/**/*.{js,ts,vue}\""
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.1.17",
        "@types/node": "^25.3.0",
        "axios": "1.13.5",
        "concurrently": "^9.0.1",
        "eslint": "^10.0.1",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-vue": "^10.8.0",
        "laravel-vite-plugin": "^2.0.0",
        "prettier": "^3.8.1",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "tailwindcss": "^4.1.17",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.56.0",
        "vite": "^7.0.7",
        "vue-tsc": "^3.2.5"
    },
    "dependencies": {
        "@eslint/js": "^10.0.1",
        "@inertiajs/vue3": "^2.2.19",
        "@vitejs/plugin-vue": "^6.0.2",
        "@vueuse/core": "^14.2.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-vue-next": "^0.575.0",
        "reka-ui": "^2.8.2",
        "tailwind-merge": "^3.5.0",
        "vue": "^3.5.25",
        "ziggy-js": "^2.6.1"
    }
}
